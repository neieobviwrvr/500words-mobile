{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // whisper.rn@0.7.2's package.json "exports" hat keinen "."-Eintrag fuer den
      // Root-Import (nur "./*"-Wildcards) - ohne diesen Path-Override loest
      // TS "bundler"-Resolution den bloßen Import "whisper.rn" nicht auf.
      "whisper.rn": ["./node_modules/whisper.rn/lib/typescript/index.d.ts"]
    }
  }
}
