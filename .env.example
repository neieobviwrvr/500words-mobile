# Kopieren nach ".env" und mit echten Werten fuellen. ".env" ist gitignored.
#
# WICHTIG: Hier gehoert der Supabase ANON/PUBLIC Key rein (Dashboard > Project
# Settings > API > "anon public"), NIEMALS der service_role/secret Key. Der
# Secret-Key aus der Notizen.txt im Projekt-Root ist nur fuer serverseitige
# Skripte (z.B. vertone.py) gedacht und darf nicht in die Mobile-App wandern -
# er wuerde beim Reverse-Engineering der App vollstaendigen DB-Zugriff offenlegen.

EXPO_PUBLIC_SUPABASE_URL=https://xculnaxfdtwzpdplvedc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
